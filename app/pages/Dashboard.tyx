page Dashboard

import { IconHome, IconDocument, IconFolder, IconArrowLeft, IconUser } from "tylix-icons"

title "Dashboard"

needs
  Auth

uses
  Posts

prefetch
  Posts.latest

permissions
  posts.view

meta
  transition "fade"
  keepAlive true
  cache 5m

state
  checkedAuth: false
  messageCount: 0

action
  addPost(post) {
    Posts.add(post)
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const messagesResult = await useApi("/api/contacts?limit=1")
    if messagesResult.ok {
      this.messageCount = messagesResult.data.meta.total
    }

    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-stone-50">

    <aside class="hidden lg:flex flex-col border-r border-stone-200 bg-white p-5">
      <div class="flex items-center gap-2.5 mb-8 px-1">
        <div class="w-8 h-8 rounded-full bg-emerald-800 flex items-center justify-center">
          <IconHome class="w-4 h-4 text-amber-300" />
        </div>
        <span class="font-serif text-emerald-900 font-semibold">Dashboard</span>
      </div>

      <a href="/dashboard" aria-current="page" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-emerald-50 text-emerald-800 text-sm font-medium mb-1">
        <IconHome class="w-4 h-4" />
        Overview
      </a>

      <p class="px-3 pt-6 pb-2 text-stone-400 text-[11px] font-semibold uppercase tracking-wider">Manage</p>
      <a href="/dashboard/messages" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-stone-600 text-sm hover:bg-stone-100 hover:text-emerald-800 transition-colors">
        <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
        Messages
      </a>
    </aside>

    <div class="px-6 lg:px-12 py-10">
      <div class="flex items-center justify-between mb-10">
        <div>
          <p class="text-amber-600 text-xs font-semibold uppercase tracking-widest mb-1">Welcome back</p>
          <h1 class="font-serif text-3xl font-semibold text-emerald-900">{{ Auth.user.name }}</h1>
        </div>
        <button onclick="{{ Auth.logout() }}" class="text-sm text-stone-600 border border-stone-300 rounded-full px-4 py-2.5 hover:bg-stone-100 transition-colors">
          Log out
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center mb-3">
            <IconUser class="w-4 h-4 text-emerald-800" />
          </div>
          <p class="text-stone-500 text-xs mb-1">Signed in as</p>
          <p class="text-stone-800 text-sm font-semibold truncate">{{ Auth.user.email }}</p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center mb-3">
            <IconDocument class="w-4 h-4 text-emerald-800" />
          </div>
          <p class="text-stone-500 text-xs mb-1">Updates posted</p>
          <p class="text-stone-800 text-2xl font-semibold">{{ Posts.data.length }}</p>
        </div>

        <a href="/dashboard/messages" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm hover:border-emerald-300 hover:-translate-y-0.5 transition-all">
          <div class="w-9 h-9 rounded-xl bg-amber-50 flex items-center justify-center mb-3">
            <IconFolder class="w-4 h-4 text-amber-600" />
          </div>
          <p class="text-stone-500 text-xs mb-1">Messages</p>
          <p class="text-stone-800 text-2xl font-semibold">{{ messageCount }}</p>
        </a>
      </div>

      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="font-serif text-xl font-semibold text-emerald-900">Updates</h2>
          <p class="text-stone-500 text-sm">News and updates shown on the website</p>
        </div>
        <CreatePostForm onCreated="{{ addPost }}" />
      </div>

{{#if Posts.loading}}
      <p class="text-stone-500 text-sm mb-10">Loading updates…</p>
{{/if}}

{{#if not Posts.loading}}
{{#if Posts.data.length is 0}}
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center mb-10">
        <h3 class="font-serif text-lg text-emerald-900 mb-1">No updates yet</h3>
        <p class="text-stone-500 text-sm max-w-sm mx-auto">Use the button above to post your first update.</p>
      </div>
{{/if}}

{{#if Posts.data.length is not 0}}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
{{#each p in Posts.data}}
        <a href="{{ '/post/post-detail?id=' + p.id }}" class="group block rounded-2xl border border-stone-200 bg-white p-6 shadow-sm hover:border-emerald-300 hover:-translate-y-0.5 hover:shadow-md transition-all">
          <h3 class="font-serif text-lg text-emerald-900 mb-1.5 group-hover:text-emerald-700 transition-colors">{{ p.title }}</h3>
          <p class="text-stone-500 text-sm line-clamp-2">{{ p.body }}</p>
        </a>
{{/each}}
      </div>
{{/if}}
{{/if}}

      <a href="/" class="inline-flex items-center gap-1.5 text-emerald-800 text-sm hover:underline font-medium">
        <IconArrowLeft class="w-4 h-4" /> Back to website
      </a>
    </div>
  </div>
{{/if}}