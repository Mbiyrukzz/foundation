page Login

uses
  Auth

state
  email: ""
  password: ""
  remember: false
  error: ""
  submitting: false

action
  setField(field, value) {
    this[field] = value
  }

  toggleRemember() {
    this.remember = not this.remember
  }

  async submit() {
    if not this.submitting {
      this.submitting = true
      this.error = ""

      const result = await Auth.login(this.email, this.password)

      if result.ok {
        window.location.href = "/dashboard"
      } else if result.status is 422 and result.data.errors {
        const firstField = Object.keys(result.data.errors)[0]
        this.error = result.data.errors[firstField][0]
        this.submitting = false
      } else {
        this.error = result.error or "Invalid email or password."
        this.submitting = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-stone-50 px-6 py-16">
    <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 rounded-2xl border border-stone-200 bg-white shadow-lg overflow-hidden">

      <div class="hidden lg:flex flex-col justify-between relative overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-800 text-white p-10">
        <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-amber-400/10 blur-2xl"></div>
        <a href="/" class="relative flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-full bg-white/10 text-amber-300 flex items-center justify-center font-serif font-semibold">A</span>
          <span class="font-serif text-lg font-semibold tracking-tight">Ashmif Foundation</span>
        </a>

        <div class="relative">
          <p lang="ar" dir="rtl" class="text-xl text-amber-300 mb-4">بِسْمِ ٱللَّٰهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</p>
          <p class="font-serif text-2xl leading-snug">
            Serving the needy, funding education, and nurturing faith in Mombasa.
          </p>
        </div>

        <p class="relative text-emerald-100/50 text-xs">© 2026 Ashmif Foundation</p>
      </div>

      <div class="flex items-center justify-center px-6 py-12">
        <div class="w-full max-w-sm">
          <a href="/" class="lg:hidden flex items-center gap-2.5 justify-center mb-8">
            <span class="w-9 h-9 rounded-full bg-emerald-800 text-amber-300 flex items-center justify-center font-serif font-semibold">A</span>
            <span class="font-serif text-lg font-semibold text-emerald-900 tracking-tight">Ashmif Foundation</span>
          </a>

          <p class="text-amber-600 text-xs font-semibold uppercase tracking-widest mb-1">Admin</p>
          <h1 class="font-serif text-3xl font-semibold text-emerald-900 mb-2">Sign in</h1>
          <p class="text-stone-500 text-sm mb-8">Manage updates and messages for the Foundation.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 mb-6">
            <p class="text-rose-700 text-sm">{{ error }}</p>
          </div>
{{/if}}

          <label for="email" class="block text-stone-600 text-xs font-medium mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            autofocus
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="w-full border border-stone-300 bg-white text-stone-800 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-emerald-600/30 focus:border-emerald-700 transition"
          />

          <label for="password" class="block text-stone-600 text-xs font-medium mb-2">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            class="w-full border border-stone-300 bg-white text-stone-800 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-emerald-600/30 focus:border-emerald-700 transition"
          />

          <div class="flex items-center justify-between mb-6">
            <label class="flex items-center gap-2 text-sm text-stone-500">
{{#if remember}}
              <input type="checkbox" checked onclick="{{ toggleRemember() }}" class="rounded border-stone-300 text-emerald-700 focus:ring-emerald-600" />
{{/if}}
{{#if not remember}}
              <input type="checkbox" onclick="{{ toggleRemember() }}" class="rounded border-stone-300 text-emerald-700 focus:ring-emerald-600" />
{{/if}}
              Remember me
            </label>
            <a href="/forgot-password" class="text-sm text-emerald-800 hover:underline">Forgot password?</a>
          </div>

{{#if submitting}}
          <button disabled class="w-full bg-emerald-800 text-white rounded-full py-2.5 font-semibold opacity-50 transition">
            Signing in…
          </button>
{{/if}}
{{#if not submitting}}
          <button onclick="{{ submit() }}" class="w-full bg-emerald-800 text-white rounded-full py-2.5 font-semibold shadow-sm hover:bg-emerald-700 hover:shadow transition-all">
            Sign In
          </button>
{{/if}}

          <p class="text-sm text-stone-500 text-center mt-6">
            <a href="/" class="text-emerald-800 hover:underline">← Back to website</a>
          </p>
        </div>
      </div>
    </div>
  </div>