page Blog

state
  loading: true
  error: ""
  posts: []

onMount
  async {
    const result = await useApi("/api/blog")
    if result.ok {
      const fmt = new Intl.DateTimeFormat("en-GB", { dateStyle: "long", timeZone: "Africa/Nairobi" })
      this.posts = result.data.data.map(p => Object.assign({}, p, { when: fmt.format(new Date(p.created_at)) }))
    } else {
      this.error = "We couldn't load the blog right now. Please try again shortly."
    }
    this.loading = false
  }

template
  <div>
    <section class="relative overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-800 text-white">
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-amber-400/10 blur-3xl"></div>
      <div class="relative max-w-4xl mx-auto px-6 py-20 text-center">
        <p class="text-xs tracking-widest uppercase text-amber-300 font-semibold mb-3">Blog</p>
        <h1 class="font-serif text-4xl md:text-5xl font-semibold mb-4 tracking-tight">News and updates</h1>
        <p class="text-emerald-100/90 max-w-xl mx-auto leading-relaxed">
          What we are doing, who we are helping, and how your giving is making a difference.
        </p>
      </div>
    </section>

    <section class="px-6 py-16 bg-stone-50">
      <div class="max-w-5xl mx-auto">

{{#if loading}}
        <Loader label="Loading updates…" />
{{/if}}

{{#if error}}
        <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 max-w-xl mx-auto">
          <p class="text-rose-700 text-sm text-center">{{ error }}</p>
        </div>
{{/if}}

{{#if not loading}}
{{#if not error}}
{{#if posts.length is 0}}
        <div class="rounded-2xl border border-dashed border-stone-300 bg-white p-14 text-center max-w-xl mx-auto">
          <p class="font-serif text-2xl text-emerald-900 mb-2">Our first updates are coming soon</p>
          <p class="text-stone-500 text-sm leading-relaxed mb-6">
            We have only just begun. Check back soon, insha'Allah, for news of our work in Mombasa.
          </p>
          <a href="/donate" class="inline-block px-7 py-3 rounded-full bg-amber-500 text-emerald-950 font-semibold hover:bg-amber-400 transition-colors">Support our work</a>
        </div>
{{/if}}

{{#if posts.length is not 0}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
{{#each p in posts}}
          <a href="{{ '/post/post-detail?id=' + p.id }}" class="group flex flex-col rounded-2xl bg-white border border-stone-200 p-8 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <p class="text-xs uppercase tracking-widest text-amber-600 font-semibold mb-3">{{ p.when }}</p>
            <h2 class="font-serif text-2xl font-semibold text-emerald-900 mb-3 leading-snug group-hover:text-emerald-700 transition-colors">{{ p.title }}</h2>
            <p class="text-stone-500 text-sm leading-relaxed mb-6 flex-1">{{ p.excerpt }}</p>
            <span class="text-sm font-semibold text-emerald-800 group-hover:text-amber-600 transition-colors">Read more →</span>
          </a>
{{/each}}
        </div>
{{/if}}
{{/if}}
{{/if}}

      </div>
    </section>
  </div>