component Programs

import { IconCheckCircle } from "tylix-icons"

state
  programs: [
    { no: "01", title: "Support for the Needy", text: "Practical help for families who have nowhere else to turn.", points: ["Food and household essentials", "Emergency assistance", "Zakat and Sadaqah distribution"] },
    { no: "02", title: "Education Funding", text: "So that no child is turned away from school because of cost.", points: ["School fee support", "Uniforms and learning materials", "Help for orphans and vulnerable students"] },
    { no: "03", title: "Madrassa", text: "Quran and Islamic studies for children, in a caring environment.", points: ["Quran reading and memorisation", "Islamic studies and good character", "A safe, welcoming place to learn"] }
  ]

template
  <section id="programs" class="px-6 py-24 bg-stone-50">
    <div class="max-w-6xl mx-auto">
      <p class="text-center text-xs tracking-widest uppercase text-amber-600 font-semibold mb-3">What we do</p>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-emerald-900 text-center mb-4 tracking-tight">Our Programs</h2>
      <p class="text-stone-500 text-center max-w-xl mx-auto mb-14">Three ways we serve our community, rooted in the Islamic duty of caring for one another.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{{#each p in programs}}
        <div class="rounded-2xl bg-white border border-stone-200 p-8 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
          <p class="font-serif text-4xl text-amber-500 mb-4">{{ p.no }}</p>
          <h3 class="font-serif text-xl font-semibold text-emerald-900 mb-2">{{ p.title }}</h3>
          <p class="text-stone-500 text-sm leading-relaxed mb-6">{{ p.text }}</p>
          <ul class="space-y-2.5">
{{#each pt in p.points}}
            <li class="flex items-start gap-2.5 text-sm text-stone-700">
              <IconCheckCircle class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" />
              <span>{{ pt }}</span>
            </li>
{{/each}}
          </ul>
        </div>
{{/each}}
      </div>
    </div>
  </section>