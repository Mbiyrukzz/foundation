component LatestUpdates

import { IconArrowRight } from "tylix-icons"

props
  posts: Array

template
{{#if posts.length is not 0}}
  <section class="px-6 py-24 bg-stone-50">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs tracking-widest uppercase text-amber-600 font-semibold mb-3">Latest</p>
          <h2 class="font-serif text-3xl md:text-4xl font-semibold text-emerald-900 tracking-tight">News and updates</h2>
        </div>
        <a href="/blog" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-emerald-800 hover:text-amber-600 transition-colors">
          All updates
          <IconArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{{#each p in posts}}
        <a href="{{ '/post/post-detail?id=' + p.id }}" class="group flex flex-col rounded-2xl bg-white border border-stone-200 p-7 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
          <p class="text-xs uppercase tracking-widest text-amber-600 font-semibold mb-3">{{ p.when }}</p>
          <h3 class="font-serif text-xl font-semibold text-emerald-900 mb-3 leading-snug group-hover:text-emerald-700 transition-colors">{{ p.title }}</h3>
          <p class="text-stone-500 text-sm leading-relaxed mb-5 flex-1">{{ p.excerpt }}</p>
          <span class="text-sm font-semibold text-emerald-800 group-hover:text-amber-600 transition-colors">Read more →</span>
        </a>
{{/each}}
      </div>

      <a href="/blog" class="sm:hidden mt-8 inline-flex items-center gap-2 text-sm font-semibold text-emerald-800">
        All updates
        <IconArrowRight class="w-4 h-4" />
      </a>
    </div>
  </section>
{{/if}}