<script>
import { IconMenu, IconX } from "tylix-icons"

uses
  Auth

state
  mobileMenuOpen: false

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }
</script>
<template>
  <div class="bg-stone-50 text-stone-800 min-h-screen">
    <nav class="px-6 lg:px-10 h-16 flex items-center justify-between sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-200">
      <a href="/" class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-full bg-emerald-800 text-amber-300 flex items-center justify-center font-serif font-semibold">A</span>
        <span class="font-serif text-lg font-semibold text-emerald-900 tracking-tight">Ashmif Foundation</span>
      </a>

      <div class="hidden lg:flex items-center gap-6 text-sm text-stone-600">
        <a href="/" class="hover:text-emerald-800 transition-colors">Home</a>
        <a href="/#about" class="hover:text-emerald-800 transition-colors">About</a>
        <a href="/#programs" class="hover:text-emerald-800 transition-colors">Programs</a>
        <a href="/blog" class="hover:text-emerald-800 transition-colors">Blog</a>
        <a href="/#help" class="hover:text-emerald-800 transition-colors">Get Involved</a>
        <a href="/contact" class="hover:text-emerald-800 transition-colors">Contact</a>
      </div>

      <div class="flex items-center gap-2">
{{#if Auth.user}}
        <a href="/dashboard" class="hidden lg:block text-sm text-stone-600 hover:text-emerald-800 transition-colors px-3 py-1.5">
          Dashboard
        </a>
        <button onclick="{{ Auth.logout() }}" class="hidden lg:block text-sm px-4 py-1.5 rounded-full border border-stone-300 text-stone-600 font-medium hover:bg-stone-100 transition-colors">
          Log out
        </button>
{{/if}}
{{#if not Auth.user}}
        <a href="/login" class="hidden lg:block text-sm text-stone-600 hover:text-emerald-800 transition-colors px-3 py-1.5">
          Login
        </a>
{{/if}}
        <a href="/donate" class="hidden sm:block text-sm px-5 py-2 rounded-full bg-amber-500 text-emerald-950 font-semibold hover:bg-amber-400 transition-colors">
          Donate
        </a>

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="lg:hidden w-9 h-9 flex items-center justify-center rounded-full text-stone-600 hover:text-emerald-800 hover:bg-stone-100 transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{/if}}
{{#if not mobileMenuOpen}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="lg:hidden border-b border-stone-200 bg-white px-6 py-6 flex flex-col gap-1 shadow-lg">
      <a href="/" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Home</a>
      <a href="/#about" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">About</a>
      <a href="/#programs" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Programs</a>
      <a href="/blog" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Blog</a>
      <a href="/#help" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Get Involved</a>
      <a href="/contact" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Contact</a>
      <div class="h-px bg-stone-200 my-2"></div>
{{#if Auth.user}}
      <a href="/dashboard" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Dashboard</a>
      <button onclick="{{ Auth.logout() }}" class="text-sm text-left text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Log out</button>
{{/if}}
{{#if not Auth.user}}
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-sm text-stone-700 hover:text-emerald-800 hover:bg-stone-100 rounded-lg px-3 py-2.5 transition-colors">Login</a>
{{/if}}
      <a href="/donate" onclick="{{ closeMobileMenu() }}" class="text-sm text-emerald-950 bg-amber-500 rounded-lg px-3 py-2.5 font-semibold text-center mt-2">Donate</a>
    </div>
{{/if}}

    <div data-tylix-slot="true"></div>
    <SiteFooter />
  </div>
</template>