page PostDetail

uses
  Auth

state
  post: null
  loading: true
  notFound: false
  deleting: false
  error: ""
  when: ""
  shareUrl: ""

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const postId = params.get("id")

    if not postId {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/blog/" + postId)

      if result.ok {
        const fmt = new Intl.DateTimeFormat("en-GB", { dateStyle: "long", timeZone: "Africa/Nairobi" })
        this.post = result.data.data
        this.when = fmt.format(new Date(this.post.created_at))
        this.shareUrl = "https://wa.me/?text=" + encodeURIComponent(this.post.title + " " + window.location.href)
        this.loading = false
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

action
  async deletePost() {
    if not this.post or this.deleting {
      return
    }

    if not window.confirm("Delete this post? This cannot be undone.") {
      return
    }

    this.deleting = true
    this.error = ""

    const result = await deleteApi("posts", this.post.id)

    if result.ok {
      window.location.href = "/dashboard"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = "Something went wrong deleting this post."
      this.deleting = false
    }
  }

template
  <div class="bg-stone-50 min-h-[calc(100vh-4rem)] px-6 py-12">
    <div class="max-w-3xl mx-auto">

{{#if loading}}
      <Loader label="Loading post…" />
{{/if}}

{{#if notFound}}
      <div class="rounded-2xl border border-stone-200 bg-white p-12 text-center shadow-sm">
        <h1 class="font-serif text-2xl font-semibold text-emerald-900 mb-2">Post not found</h1>
        <p class="text-stone-500 text-sm mb-6">It may have been removed, or the link is wrong.</p>
        <a href="/blog" class="text-emerald-800 text-sm font-semibold hover:underline">← All updates</a>
      </div>
{{/if}}

{{#if post}}
      <a href="/blog" class="inline-flex items-center gap-1 text-emerald-800 text-sm font-medium hover:underline mb-6">← All updates</a>

      <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-8 md:p-12">
        <p class="text-xs uppercase tracking-widest text-amber-600 font-semibold mb-4">{{ when }}</p>
        <h1 class="font-serif text-3xl md:text-4xl font-semibold text-emerald-900 leading-tight mb-8">{{ post.title }}</h1>
        <div class="h-px bg-stone-200 mb-8"></div>
        <p class="text-stone-700 leading-8 whitespace-pre-line">{{ post.body }}</p>

        <div class="mt-12 pt-8 border-t border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <a href="{{ shareUrl }}" target="_blank" rel="noopener" class="text-sm font-semibold text-emerald-800 hover:text-amber-600 transition-colors">Share on WhatsApp</a>
          <a href="/donate" class="px-6 py-2.5 rounded-full bg-amber-500 text-emerald-950 text-sm font-semibold hover:bg-amber-400 transition-colors">Support our work</a>
        </div>
      </article>

{{#if Auth.user}}
      <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 flex items-center justify-between gap-4">
        <p class="text-stone-500 text-sm">You are signed in as admin.</p>
        <div class="flex items-center gap-3">
{{#if error}}
          <p role="alert" class="text-rose-700 text-sm">{{ error }}</p>
{{/if}}
{{#if deleting}}
          <button disabled class="inline-flex items-center gap-2 text-sm text-stone-500 border border-stone-300 rounded-full px-4 py-2 opacity-70">
            <Spinner /> Deleting…
          </button>
{{/if}}
{{#if not deleting}}
          <button onclick="{{ deletePost() }}" class="text-sm text-stone-600 border border-stone-300 rounded-full px-4 py-2 hover:border-rose-300 hover:text-rose-700 transition-colors">
            Delete post
          </button>
{{/if}}
        </div>
      </div>
{{/if}}
{{/if}}

    </div>
  </div>